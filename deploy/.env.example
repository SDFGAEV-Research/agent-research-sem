# Linux host or Windows Docker Desktop/WSL2; application runtime is Linux.
NODE_VERSION=22.22.2
MC_SERVER_VERSION=1.21.8
MC_PORT=25565
MC_T2B_TIMEOUT_S=180

# One immutable image tag is built once and reused on every server.
# Production automation should replace "local" with the exact Git commit.
PLATFORM_IMAGE=research-platform:local

# Persistent runtime data must live on the selected host data disk.
# Server examples:
#   server1: /data1/research-platform/runtime
#   server2: /data/hdd1/research-platform/runtime
PLATFORM_HOST_DATA_ROOT=./.runtime
