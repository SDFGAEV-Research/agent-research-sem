# Non-secret enrollment template for the three GPU servers in the controller fleet.
# Authentication secrets are intentionally excluded; automation uses SSH key/agent auth.
RP_SERVER_CATALOG_IDS=sem-ubuntu,node-118-190-202-247,node-121-48-164-241

# Server 3 / SEM: RTX 3090 host; sudo available; Docker must be re-qualified.
RP_SERVER_SEM_UBUNTU_HOST=103.40.13.126
RP_SERVER_SEM_UBUNTU_PORT=60320
RP_SERVER_SEM_UBUNTU_USER=ubuntu
# RP_SERVER_SEM_UBUNTU_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_SEM_UBUNTU_SSH_CONFIG=<absolute-local-ssh-config-path>

# Server 1: RTX 5000 Ada host; ~5.5 TB data storage; Docker installed.
RP_SERVER_NODE_118_190_202_247_HOST=118.190.202.247
RP_SERVER_NODE_118_190_202_247_PORT=30056
RP_SERVER_NODE_118_190_202_247_USER=gpuadmin
# RP_SERVER_NODE_118_190_202_247_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_NODE_118_190_202_247_SSH_CONFIG=<absolute-local-ssh-config-path>

# Server 2: shared RTX 4090 host; Docker and sudo available.
RP_SERVER_NODE_121_48_164_241_HOST=121.48.164.241
RP_SERVER_NODE_121_48_164_241_PORT=32155
RP_SERVER_NODE_121_48_164_241_USER=ubuntu
# RP_SERVER_NODE_121_48_164_241_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_NODE_121_48_164_241_SSH_CONFIG=<absolute-local-ssh-config-path>

# Runtime roots, executable digests, and host-key policy must be attested by the
# server qualification workflow after authentication succeeds; do not guess them.