# Non-secret enrollment template for the three SSH endpoints currently known to
# the controller. Copy to an ignored *.local.env file and fill local identity
# paths. Runtime fields are intentionally absent for the two unverified hosts;
# the server qualification route must attest those fields before mutation.
RP_SERVER_CATALOG_IDS=sem-ubuntu,node-121-48-164-162,node-121-48-162-165

# Existing SEM host. Use the complete sem-ubuntu.example.env profile when the
# host has been fully attested; this entry is connection enrollment only.
RP_SERVER_SEM_UBUNTU_HOST=103.40.13.126
RP_SERVER_SEM_UBUNTU_PORT=60320
RP_SERVER_SEM_UBUNTU_USER=ubuntu
# RP_SERVER_SEM_UBUNTU_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_SEM_UBUNTU_SSH_CONFIG=<absolute-local-ssh-config-path>

# SSH config entry: 121.48.164.162:22 / courseliu.
RP_SERVER_NODE_121_48_164_162_HOST=121.48.164.162
RP_SERVER_NODE_121_48_164_162_PORT=22
RP_SERVER_NODE_121_48_164_162_USER=courseliu
# RP_SERVER_NODE_121_48_164_162_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_NODE_121_48_164_162_SSH_CONFIG=<absolute-local-ssh-config-path>

# SSH config entry: 121.48.162.165:32769 / ubuntu.
RP_SERVER_NODE_121_48_162_165_HOST=121.48.162.165
RP_SERVER_NODE_121_48_162_165_PORT=32769
RP_SERVER_NODE_121_48_162_165_USER=ubuntu
# RP_SERVER_NODE_121_48_162_165_KEY_PATH=<absolute-local-private-key-path>
# RP_SERVER_NODE_121_48_162_165_SSH_CONFIG=<absolute-local-ssh-config-path>

# Do not add remote paths or executable digests by hand. Complete each entry
# through the server qualification/attestation workflow after authentication
# succeeds. The catalog will then expose the exact missing runtime fields.
