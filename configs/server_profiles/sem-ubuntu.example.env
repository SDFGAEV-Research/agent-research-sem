# Copy to a local ignored file and fill values there. Never commit credentials.
RP_SERVER_CATALOG_IDS=sem-ubuntu
RP_SERVER_SEM_UBUNTU_HOST=<server-host>
RP_SERVER_SEM_UBUNTU_PORT=60320
RP_SERVER_SEM_UBUNTU_USER=ubuntu
# Prefer an SSH key or agent for unattended operation.
RP_SERVER_SEM_UBUNTU_KEY_PATH=<local-private-key-path>
# Optional: explicit SSH config. On Windows, use the absolute path to
# configs/server_profiles/empty.ssh_config when the default ~/.ssh/config
# fails OpenSSH permission checks. Do not use NUL as the path.
RP_SERVER_SEM_UBUNTU_SSH_CONFIG=<local-ssh-config-path>
# Optional executable overrides.
# RP_SERVER_SEM_UBUNTU_SSH=ssh
# RP_SERVER_SEM_UBUNTU_SCP=scp
# Optional OpenSSH connection multiplexing. The parent directory is created
# by the server connection system; the path remains local to the controller.
# Keep the absolute path short: OpenSSH control sockets have a 108-byte limit
# after %C expands to the connection digest.
# RP_SERVER_SEM_UBUNTU_SSH_CONTROL_PATH=<short-absolute-local-state-dir>/rp-ssh-%C
# RP_SERVER_SEM_UBUNTU_SSH_CONTROL_PERSIST_SECONDS=600
# Optional command-level transport controls. Every SSH/SCP operation is
# bounded and is classified in the local server operation ledger.
# RP_SERVER_SEM_UBUNTU_SSH_COMMAND_TIMEOUT_SECONDS=120
# RP_SERVER_SEM_UBUNTU_SSH_OUTPUT_LIMIT_BYTES=8388608

# Remote lifecycle profile. These values are non-secret and must be explicit;
# operator/release scripts do not guess remote paths or tool versions.
RP_SERVER_SEM_UBUNTU_PLATFORM_ROOT=/data/research-platform
RP_SERVER_SEM_UBUNTU_RELEASE_ROOT=/data/research-platform/releases
RP_SERVER_SEM_UBUNTU_OPERATOR_CWD=/data/research-platform
RP_SERVER_SEM_UBUNTU_OPERATOR_SHELL=/usr/bin/bash
RP_SERVER_SEM_UBUNTU_OPERATOR_SHELL_ARGS=-il
RP_SERVER_SEM_UBUNTU_REMOTE_ENV=/usr/bin/env
RP_SERVER_SEM_UBUNTU_SHA256SUM=/usr/bin/sha256sum
RP_SERVER_SEM_UBUNTU_PYTHON=/data/research-platform/envs/sem-paper/bin/python
RP_SERVER_SEM_UBUNTU_PYTHON_SHA256=b37974b112ebef9962999fce5e91ec4e4e1454715b829bddde4ac04f8213190d
RP_SERVER_SEM_UBUNTU_PYTHON_PACKAGES_SHA256=c54e3ddbc3b148e95f3c089d594c98f2ac4b2dab038546719025be935ba600b5
RP_SERVER_SEM_UBUNTU_NODE=/data/research-platform/toolchains/node-v22.22.2-linux-x64/bin/node
RP_SERVER_SEM_UBUNTU_NODE_SHA256=81925c0995b5c1427b5d538e6a90ca2fdc4daffb786b09af749beaf7369d4e90
RP_SERVER_SEM_UBUNTU_JAVA=/data/ubuntu/cef-hicc-multiserver-D/runtime/jre-21.0.8/bin/java
RP_SERVER_SEM_UBUNTU_JAVA_SHA256=f07091f28583446f1b0c1b849e602b03fb4897e3ff37f16fc2e22a16b9c70acb
RP_SERVER_SEM_UBUNTU_PLATFORM_MANAGE=/data/research-platform/envs/sem-paper/bin/research-platform-manage
RP_SERVER_SEM_UBUNTU_PLATFORM_MANAGE_SHA256=3e266303dd33f352f62d4627d85b828b948efc7c309cd461f2b0859650b67e7e
RP_SERVER_SEM_UBUNTU_TMUX=/usr/local/bin/tmux
RP_SERVER_SEM_UBUNTU_TMUX_SHA256=b079dbc82b2ca2544caa7f84d7a618e2be3990c45f4f4c51e43a24348f393bdd
RP_SERVER_SEM_UBUNTU_TMUX_SERVER_LABEL=research-platform
RP_SERVER_SEM_UBUNTU_TMUX_CONFIG=/dev/null
RP_SERVER_SEM_UBUNTU_TMUX_SOCKET_DIRECTORY=/tmp
RP_SERVER_SEM_UBUNTU_SESSION_NAME=research-platform-shell
RP_SERVER_SEM_UBUNTU_LOCAL_BINDING_ROOT=<absolute-local-state-dir>/server-sessions/sem-ubuntu
RP_SERVER_SEM_UBUNTU_REMOTE_HOME=/data/users/ubuntu
RP_SERVER_SEM_UBUNTU_REMOTE_PATH=/data/research-platform/toolchains/node-v22.22.2-linux-x64/bin:/data/research-platform/envs/sem-paper/bin:/data/ubuntu/cef-hicc-multiserver-D/runtime/jre-21.0.8/bin:/usr/local/bin:/usr/bin:/bin
RP_SERVER_SEM_UBUNTU_TERM=xterm-256color
