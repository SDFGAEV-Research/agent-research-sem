{
  "deployment_id": "sem-paper-qwen36-planner",
  "scope": {
    "kind": "platform",
    "scope_id": "default"
  },
  "service_id": "model:sem-paper-qwen36-planner",
  "model_id": "qwen36-35b-a3b",
  "engine": "vllm",
  "executable": "{python}",
  "argv": [
    "{python}",
    "-m",
    "vllm.entrypoints.openai.api_server",
    "--model",
    "{model_path}",
    "--served-model-name",
    "sem-paper-qwen36-35b-a3b",
    "--host",
    "127.0.0.1",
    "--port",
    "30000",
    "--tensor-parallel-size",
    "4",
    "--reasoning-parser",
    "qwen3",
    "--disable-custom-all-reduce",
    "--max-model-len",
    "262144"
