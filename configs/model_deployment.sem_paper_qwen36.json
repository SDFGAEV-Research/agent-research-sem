  "cwd": "/data/research-platform/workspaces/platform/default/model-serving/sem-paper-model-serving",
  "python_environment_id": "qwen36-vllm-v0271-cu130",
  "gpu_devices": ["0", "1", "3", "4"],
  "environment": {
    "HOME": "/data/research-platform/workspaces/platform/default/model-serving/sem-paper-model-serving/home",
    "LD_LIBRARY_PATH": "/data/research-platform/envs/sem-paper/lib",
    "TOKENIZERS_PARALLELISM": "true"
  },
  "readiness_url": "http://127.0.0.1:30000/health",
  "readiness_timeout_s": 300,
  "stop_timeout_s": 60,
  "heartbeat_interval_s": 10,
  "desired_state": "running",
  "tags": ["paper1", "sem-paper", "qwen36", "planner", "vllm"]
}
